---
import { site } from '../config';
---

<div class="reveal mt-14 flex justify-center" style="--delay: 200ms">
  <a
    href={site.googleReviewUrl}
    target="_blank"
    rel="noopener"
    class="group relative inline-flex items-center gap-4 overflow-hidden rounded-full border border-white/10 bg-night-800/70 py-3 pr-7 pl-3 shadow-lg shadow-black/30 backdrop-blur transition-all duration-500 ease-out hover:-translate-y-0.5 hover:border-taxi-500/40 hover:bg-night-800 hover:shadow-xl hover:shadow-taxi-500/10 sm:pr-8"
  >
    <!-- Hover'da üzerinden geçen ışık parlaması -->
    <span
      class="pointer-events-none absolute inset-y-0 -left-full w-1/2 -skew-x-12 bg-linear-to-r from-transparent via-white/10 to-transparent transition-[left] duration-700 ease-out group-hover:left-[130%]"
    ></span>

    <!-- Google "G" logosu -->
    <span class="grid size-11 shrink-0 place-items-center rounded-full bg-white shadow-inner transition-transform duration-500 group-hover:rotate-[360deg]">
      <svg class="size-6" viewBox="0 0 48 48" aria-hidden="true">
        <path fill="#FFC107" d="M43.6 20.5H42V20H24v8h11.3C33.7 32.7 29.2 36 24 36c-6.6 0-12-5.4-12-12s5.4-12 12-12c3.1 0 5.8 1.2 7.9 3.1l5.7-5.7C34 6.1 29.3 4 24 4 12.9 4 4 12.9 4 24s8.9 20 20 20 20-8.9 20-20c0-1.3-.1-2.4-.4-3.5z" />
        <path fill="#FF3D00" d="m6.3 14.7 6.6 4.8C14.7 15.1 19 12 24 12c3.1 0 5.8 1.2 7.9 3.1l5.7-5.7C34 6.1 29.3 4 24 4 16.3 4 9.7 8.3 6.3 14.7z" />
        <path fill="#4CAF50" d="M24 44c5.2 0 9.9-2 13.4-5.2l-6.2-5.2A11.9 11.9 0 0 1 24 36c-5.2 0-9.6-3.3-11.3-7.9l-6.5 5C9.5 39.6 16.2 44 24 44z" />
        <path fill="#1976D2" d="M43.6 20.5H42V20H24v8h11.3a12 12 0 0 1-4.1 5.6l6.2 5.2C37 39.2 44 34 44 24c0-1.3-.1-2.4-.4-3.5z" />
      </svg>
    </span>

    <span class="relative flex flex-col text-left">
      <span class="flex gap-0.5 text-taxi-400" aria-hidden="true">
        {
          Array.from({ length: 5 }, (_, i) => (
            <svg
              class="size-3.5 transition-transform duration-300 group-hover:scale-125"
              style={`transition-delay: ${i * 60}ms`}
              viewBox="0 0 24 24"
              fill="currentColor"
            >
              <path d="m12 2 3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z" />
            </svg>
          ))
        }
      </span>
      <span class="mt-1 text-base font-semibold text-white sm:text-lg">Bizi Google'da Değerlendirin</span>
    </span>

    <svg
      class="relative ml-1 size-5 text-slate-500 transition-all duration-300 group-hover:translate-x-1 group-hover:text-taxi-400"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <path d="M5 12h14M13 6l6 6-6 6"></path>
    </svg>
  </a>
</div>
