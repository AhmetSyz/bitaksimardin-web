---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import type { TaxiPhoto } from '../lib/photos';

// Fotoğraf varsa optimize edilmiş <Image>, yoksa aynı oranda şık bir placeholder gösterir.
interface Props {
  photo?: TaxiPhoto;
  /** Tarayıcıya hangi genişlikte gösterileceğini söyler (responsive srcset için) */
  sizes: string;
  class?: string;
  priority?: boolean;
}

const { photo, sizes, class: className = '', priority = false } = Astro.props;
---

<div class:list={['relative overflow-hidden bg-night-800', className]}>
  {
    photo ? (
      <Image
        src={photo.src}
        alt={photo.alt}
        widths={[400, 640, 960, 1280]}
        sizes={sizes}
        format="webp"
        quality={78}
        loading={priority ? 'eager' : 'lazy'}
        fetchpriority={priority ? 'high' : 'auto'}
        class="h-full w-full object-cover"
      />
    ) : (
      <div class="absolute inset-0 grid place-items-center bg-linear-to-br from-night-700 to-night-800">
        <div class="text-center text-slate-500">
          <Icon name="car" class="mx-auto size-16 text-taxi-500/40" />
          <p class="mt-3 text-xs">Fotoğraf: src/assets/taxi/</p>
        </div>
      </div>
    )
  }
  <slot />
</div>
