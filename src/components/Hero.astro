---
import Icon from './Icon.astro';
import { site, telHref, whatsappHref, mapsHref } from '../config';

const badges = ['7/24 Açık', 'Sabit & Uygun Fiyat', 'Lisanslı Araç'];
---

<section class="relative isolate flex min-h-[100svh] items-center overflow-hidden pt-16">
  <!-- Arka plan görseli (placeholder). Gerçek fotoğrafla değiştirin: /public/images/hero.jpg -->
  <img
    src="/images/hero-placeholder.svg"
    alt=""
    class="absolute inset-0 -z-20 h-full w-full scale-105 object-cover"
    fetchpriority="high"
    decoding="async"
  />
  <!-- Okunabilirlik için koyu gradyan katmanları -->
  <div class="absolute inset-0 -z-10 bg-linear-to-b from-night-950/70 via-night-950/60 to-night-950"></div>
  <div class="absolute inset-0 -z-10 bg-[radial-gradient(ellipse_at_top_left,rgba(245,197,24,0.12),transparent_55%)]"></div>

  <div class="mx-auto w-full max-w-6xl px-5 py-20 md:py-28">
    <div class="max-w-2xl">
      <p class="reveal mb-6 inline-flex items-center gap-2 rounded-full border border-taxi-500/30 bg-taxi-500/10 px-4 py-1.5 text-xs font-semibold text-taxi-300 sm:text-sm">
        <span class="relative flex size-2">
          <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-taxi-400 opacity-75"></span>
          <span class="relative inline-flex size-2 rounded-full bg-taxi-400"></span>
        </span>
        Şu an müsait · {site.city}
      </p>

      <h1
        class="reveal text-4xl leading-[1.1] font-extrabold tracking-tight text-white sm:text-5xl md:text-6xl lg:text-7xl"
        style="--delay: 100ms"
      >
        Güvenli ve <span class="bg-linear-to-r from-taxi-300 to-taxi-500 bg-clip-text text-transparent">Hızlı</span>{' '}<br class="sm:hidden" />Ulaşım
      </h1>

      <p class="reveal mt-6 max-w-xl text-lg leading-relaxed text-slate-300 md:text-xl" style="--delay: 200ms">
        {site.city}'in her noktasına, günün her saati. Tek dokunuşla arayın, dakikalar içinde kapınızda olalım.
      </p>

      <div class="reveal mt-10 flex flex-col gap-4 sm:flex-row sm:flex-wrap" style="--delay: 300ms">
        <a href={telHref} class="btn btn-primary animate-pulse-ring text-lg">
          <Icon name="phone" class="size-5" />
          Hemen Ara
        </a>
        <a
          href={whatsappHref}
          target="_blank"
          rel="noopener"
          class="btn btn-whatsapp animate-pulse-ring text-lg [--pulse-color:#25d366] [animation-delay:1.1s]"
        >
          <Icon name="whatsapp" class="size-5" />
          WhatsApp'tan Çağır
        </a>
        <a href={mapsHref} target="_blank" rel="noopener" class="btn btn-ghost text-lg">
          <Icon name="map" class="size-5" />
          Konum
        </a>
      </div>

      <ul class="reveal mt-10 flex flex-wrap gap-x-6 gap-y-3 text-sm text-slate-400" style="--delay: 400ms">
        {
          badges.map((b) => (
            <li class="flex items-center gap-2">
              <Icon name="check" class="size-4 text-taxi-400" />
              {b}
            </li>
          ))
        }
      </ul>
    </div>
  </div>

  <a
    href="#hizmetler"
    class="absolute bottom-8 left-1/2 hidden -translate-x-1/2 animate-float text-slate-500 transition-colors hover:text-taxi-400 md:block"
    aria-label="Aşağı kaydır"
  >
    <svg class="size-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
      <path d="m6 9 6 6 6-6"></path>
    </svg>
  </a>
</section>
