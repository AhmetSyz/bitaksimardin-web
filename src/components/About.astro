---
import Icon from './Icon.astro';
import { site } from '../config';

const stats = [
  { value: '15+', label: 'Yıllık Tecrübe' },
  { value: '10.000+', label: 'Mutlu Yolcu' },
  { value: '4.9', label: 'Müşteri Puanı' },
];

const points = [
  'Profesyonel ve güler yüzlü şoför',
  'Düzenli bakımı yapılan, sigortalı araç',
  'Taksimetre ile şeffaf ücretlendirme',
  'Bagaj ve çocuk koltuğu desteği',
];
---

<section class="relative overflow-hidden bg-night-900 py-24 md:py-32">
  <div class="pointer-events-none absolute top-1/2 -right-40 size-96 -translate-y-1/2 rounded-full bg-taxi-500/5 blur-3xl"></div>

  <div class="mx-auto grid max-w-6xl gap-14 px-5 lg:grid-cols-2 lg:gap-20">
    <div class="reveal">
      <span class="section-eyebrow">Hikâyemiz</span>
      <h2 class="text-3xl font-bold tracking-tight text-white md:text-4xl">
        Size kendi aracınızdaymış gibi hissettiren yolculuklar
      </h2>
      <p class="mt-6 text-lg leading-relaxed text-slate-400">
        Ben {site.driver}. Yıllardır {site.city}'in tarihi sokaklarında, havalimanı yolunda ve ilçeler arasında
        yolcularımı güvenle taşıyorum. Dakiklik, temizlik ve saygı benim için bir iş değil, bir söz.
      </p>
      <p class="mt-4 text-lg leading-relaxed text-slate-400">
        Aracım her gün temizlenir, bakımları zamanında yapılır. Yolculuğunuz boyunca tek düşünmeniz gereken, varacağınız
        yer olsun.
      </p>
    </div>

    <div class="reveal" style="--delay: 100ms">
      <ul class="grid gap-4">
        {
          points.map((p) => (
            <li class="flex items-center gap-4 rounded-2xl border border-white/5 bg-night-800/60 px-5 py-4 text-slate-200">
              <span class="grid size-9 shrink-0 place-items-center rounded-xl bg-taxi-500/15 text-taxi-400">
                <Icon name="check" class="size-4" />
              </span>
              {p}
            </li>
          ))
        }
      </ul>

      <dl class="mt-10 grid grid-cols-3 gap-4 border-t border-white/5 pt-10">
        {
          stats.map((s) => (
            <div>
              <dt class="sr-only">{s.label}</dt>
              <dd class="text-2xl font-extrabold text-taxi-400 sm:text-4xl">{s.value}</dd>
              <dd class="mt-1 text-xs text-slate-400 sm:text-sm">{s.label}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </div>
</section>
