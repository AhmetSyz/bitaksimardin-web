---
import PhotoFrame from './PhotoFrame.astro';
import type { TaxiPhoto } from '../lib/photos';

// Alt sayfalar için hero: solda başlık/metin, sağda dikey (3:4) taksi fotoğrafları.
interface Props {
  eyebrow: string;
  title: string;
  text: string;
  photos: (TaxiPhoto | undefined)[];
}

const { eyebrow, title, text, photos } = Astro.props;
const [main, secondary] = photos;
---

<section class="relative isolate overflow-hidden pt-28 pb-20 md:pt-36 md:pb-28">
  <div class="absolute inset-0 -z-10 bg-[radial-gradient(ellipse_at_top_left,rgba(245,197,24,0.10),transparent_55%)]"></div>

  <div class="mx-auto grid max-w-6xl items-center gap-12 px-5 lg:grid-cols-[1.1fr_1fr] lg:gap-16">
    <div>
      <span class="section-eyebrow reveal">{eyebrow}</span>
      <h1 class="reveal text-4xl leading-[1.1] font-extrabold tracking-tight text-white sm:text-5xl md:text-6xl" style="--delay: 100ms">
        {title}
      </h1>
      <p class="reveal mt-6 max-w-xl text-lg leading-relaxed text-slate-300" style="--delay: 200ms">{text}</p>
      <div class="reveal mt-10" style="--delay: 300ms">
        <slot />
      </div>
    </div>

    <div class="reveal relative mx-auto w-full max-w-md lg:max-w-none" style="--delay: 150ms">
      <PhotoFrame
        photo={main}
        priority
        sizes="(min-width: 1024px) 460px, (min-width: 640px) 448px, 90vw"
        class="aspect-[3/4] rounded-[2rem] border border-white/10 shadow-2xl shadow-black/50 lg:ml-auto lg:w-[85%]"
      >
        <div class="pointer-events-none absolute inset-x-0 bottom-0 h-1/3 bg-linear-to-t from-night-950/60 to-transparent"></div>
      </PhotoFrame>

      {
        secondary && (
          <div class="absolute -bottom-8 -left-2 hidden w-40 sm:block lg:left-0 lg:w-48">
            <PhotoFrame
              photo={secondary}
              sizes="200px"
              class="aspect-[3/4] rounded-2xl border-4 border-night-950 shadow-2xl"
            />
          </div>
        )
      }
    </div>
  </div>
</section>
